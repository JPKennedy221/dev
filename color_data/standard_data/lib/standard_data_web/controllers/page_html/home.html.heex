<!-- homepage.heex -->

<div class="flex h-screen bg-gray-100">

  <!-- Main Content Area -->
  <main class="flex-1 p-8">
    <h1 class="text-3xl font-bold mb-6"><%= @page_title || "Welcome to the Homepage" %></h1>
    <p class="text-gray-700 mb-4">
      This is your main content area. Select a menu option to get started.
    </p>

    <!-- Placeholder for dynamic content -->
    <div id="main-content" class="bg-white p-6 rounded-lg shadow-md">
      <p>Content will be displayed here based on the selected menu item.</p>
    </div>
  </main>
</div>